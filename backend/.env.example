PORT=4000

# Neon Postgres connection string. Use the **pooled** URL (the one with
# `-pooler` in the hostname) on Render. Local dev can use the direct URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Google Gemini API key — optional. Without it, the AI chat falls back to a
# small local reply builder; recommendations still work via local ranking.
GEMINI_API_KEY=replace-me

# Comma-separated list of allowed origins for CORS.
# Include the Vercel deployment URL of this frontend, plus http://localhost:3000
# for local dev. Example for production:
# FRONTEND_URL=https://journey-junction.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

PLATFORM_COMMISSION_PCT=30

NODE_ENV=development
